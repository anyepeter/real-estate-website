# Copy to .env.local and fill in. .env* is gitignored — never commit real values.

# Neon Postgres. Use the POOLED connection string, not the direct one:
# serverless functions open and close connections constantly and the pooler
# is what stops that exhausting the database.
#   neon.tech -> your project -> Connection Details -> Pooled connection
DATABASE_URI=postgresql://user:password@host/dbname?sslmode=require

# Signs admin sessions. Any long random string; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it logs everyone out. There is no fallback in payload.config.ts
# on purpose — a missing secret should fail at boot, not sign sessions with "".
PAYLOAD_SECRET=

# Bearer token for /cron/expiry, the nightly compliance sweep. Vercel Cron
# sends this automatically once it's set in the project's environment.
# That endpoint can unpublish listings, so it fails closed: if this is unset
# the route rejects every request rather than running unauthenticated.
CRON_SECRET=
